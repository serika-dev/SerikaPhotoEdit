set(CPACK_PACKAGE_NAME "SerikaPhotoEdit")
set(CPACK_PACKAGE_VENDOR "Serika")
set(CPACK_PACKAGE_VERSION "1.0.0")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native photo editing with layers, masks, RAW and PSD")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Serika PhotoEdit")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_EXECUTABLES "SerikaPhotoEdit;Serika PhotoEdit")
if(WIN32)
  set(CPACK_GENERATOR "ZIP;WIX")
  set(CPACK_WIX_VERSION 3)
  set(CPACK_WIX_LICENSE_RTF "${CMAKE_SOURCE_DIR}/packaging/windows/License.rtf")
  set(CPACK_WIX_UPGRADE_GUID "AFC494F7-1A94-48D5-96D4-648E5E864504")
  set(CPACK_WIX_PRODUCT_ICON "${CMAKE_SOURCE_DIR}/packaging/windows/serika.ico")
  set(CPACK_WIX_PROGRAM_MENU_FOLDER "Serika")
  set(CPACK_WIX_UI_REF "WixUI_FeatureTree")
  set(CPACK_WIX_EXTRA_SOURCES "${CMAKE_SOURCE_DIR}/packaging/windows/Associations.wxs")
  set(CPACK_WIX_PATCH_FILE "${CMAKE_SOURCE_DIR}/packaging/windows/Associations-patch.xml")
elseif(APPLE)
  set(CPACK_GENERATOR "DragNDrop;TGZ")
  set(CPACK_DMG_VOLUME_NAME "Serika PhotoEdit")
else()
  set(CPACK_GENERATOR "TGZ;DEB;RPM")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Serika")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_RPM_PACKAGE_LICENSE "MIT")
  set(CPACK_RPM_PACKAGE_AUTOREQ ON)
endif()
include(CPack)
